{% extends 'layouts/adminlte.twig' %}

{% block title %}Usuário | {{ app_name }}{% endblock %}
{% block page_title %}Usuário{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">{{ usuario_cadastro.des002 }}</h4><p class="text-muted mb-0">Detalhes do usuário.</p></div><div><a href="/usuarios" class="btn btn-outline-secondary">Voltar</a><a href="/usuarios/{{ usuario_cadastro.cod002 }}/editar" class="btn btn-primary">Editar</a></div></div>
    <div class="card"><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-3">Código</dt><dd class="col-sm-9">#{{ usuario_cadastro.cod002 }}</dd>
        <dt class="col-sm-3">Empresa</dt><dd class="col-sm-9">{{ usuario_cadastro.des001 }}</dd>
        <dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">{{ usuario_cadastro.ema002 }}</dd>
        <dt class="col-sm-3">Perfil</dt><dd class="col-sm-9">{{ usuario_cadastro.des014 }}</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge text-bg-{{ usuario_cadastro.sts002 ? 'success' : 'secondary' }}">{{ usuario_cadastro.sts002 ? 'Ativo' : 'Inativo' }}</span></dd>
    </dl></div></div>
{% endblock %}
