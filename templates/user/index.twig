{% extends 'layouts/adminlte.twig' %}

{% block title %}Usuários | {{ app_name }}{% endblock %}
{% block page_title %}Usuários{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1"><i class="bi bi-people me-2"></i>Usuários</h4>
            <p class="text-muted mb-0">Gerencie os usuários da plataforma.</p>
        </div>
        <a href="/usuarios/novo" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Novo usuário</a>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Código</th><th>Nome</th><th>E-mail</th><th>Empresa</th><th>Perfil</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    {% for usuario_lista in usuarios %}
                        <tr>
                            <td>#{{ usuario_lista.cod002 }}</td>
                            <td>{{ usuario_lista.des002 }}</td>
                            <td>{{ usuario_lista.ema002 }}</td>
                            <td>{{ usuario_lista.des001 }}</td>
                            <td>{{ usuario_lista.des014 }}</td>
                            <td><span class="badge text-bg-{{ usuario_lista.sts002 ? 'success' : 'secondary' }}">{{ usuario_lista.sts002 ? 'Ativo' : 'Inativo' }}</span></td>
                            <td class="text-end">
                                <a href="/usuarios/{{ usuario_lista.cod002 }}" class="btn btn-sm btn-outline-primary" title="Visualizar"><i class="bi bi-eye"></i></a>
                                <a href="/usuarios/{{ usuario_lista.cod002 }}/editar" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="text-center py-4 text-muted">Nenhum usuário encontrado.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
