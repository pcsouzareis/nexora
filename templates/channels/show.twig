{% extends 'layouts/adminlte.twig' %}
{% block title %}{{ canal.des003 }} | {{ app_name }}{% endblock %}
{% block page_title %}Canal: {{ canal.des003 }}{% endblock %}
{% block content %}
<div class="row"><div class="col-lg-8"><div class="card"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">{{ canal.tip003 }}</dd><dt class="col-sm-4">Base padrão</dt><dd class="col-sm-8">{{ canal.base|default('Não definida') }}</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">{{ canal.sts003 ? 'Ativo' : 'Inativo' }}</dd></dl></div><div class="card-footer">{% if can_update %}<a class="btn btn-primary" href="/canais/{{ canal.cod003 }}/editar">Editar</a>{% endif %}<a class="btn btn-outline-secondary" href="/canais">Voltar</a></div></div>
{% if webhook_secret %}<div class="alert alert-warning"><strong>Guarde esta chave agora:</strong><br><code>{{ webhook_secret }}</code><br><small>Ela não será exibida novamente.</small></div>{% endif %}
{% if canal.tip003 == 'Web' and canal.pub003 %}<div class="card"><div class="card-header"><strong>Webchat</strong></div><div class="card-body"><label class="form-label">Caminho público <i class="bi bi-question-circle ms-1 text-muted" tabindex="0" data-bs-toggle="tooltip" title="Endereço que pode ser aberto diretamente ou usado em um iframe no site da empresa. O token não é uma chave da IA."></i></label><input class="form-control" readonly value="/chat/{{ canal.pub003 }}"><p class="text-muted mt-2 mb-0">Vinculado à base: {{ canal.base }}.</p></div>{% if can_update %}<div class="card-footer"><form method="post" action="/canais/{{ canal.cod003 }}/novo-token-webchat"><button class="btn btn-outline-warning btn-sm" data-bs-toggle="tooltip" title="Invalida o endereço público atual. Atualize o iframe no site após gerar um novo token.">Gerar novo token público</button></form></div>{% endif %}</div>{% endif %}
{% if canal.tip003 == 'WhatsApp' %}<div class="card"><div class="card-header"><strong>Z-API</strong></div><div class="card-body"><p class="mb-1">Instância: {{ canal.ins003|default('Não configurada') }}</p><p class="mb-0">Envio humano: {{ canal.out003 and canal.zapi_configured ? 'ativo' : 'não configurado ou inativo' }}</p></div></div>{% endif %}
{% if canal.tip003 == 'E-Mail' %}<div class="card"><div class="card-header"><strong>Conta de e-mail</strong></div><div class="card-body"><p class="mb-1">IMAP: {{ canal.imh003|default('Não configurado') }}{% if canal.imp003 %}:{{ canal.imp003 }}{% endif %}</p><p class="mb-1">SMTP: {{ canal.smh003|default('Não configurado') }}{% if canal.smp003 %}:{{ canal.smp003 }}{% endif %}</p><p class="mb-0">Envio automático: {{ canal.outema003 and canal.email_configured ? 'ativo' : 'não configurado ou inativo' }}</p></div></div>{% endif %}
{% if canal.tip003 == 'Telegram' %}<div class="card"><div class="card-header"><strong>Bot do Telegram</strong></div><div class="card-body"><p class="mb-1">Credencial: {{ canal.telegram_configured ? 'configurada' : 'não configurada' }}</p><p class="mb-0">Respostas automáticas: {{ canal.outtel003 and canal.telegram_configured ? 'ativas' : 'inativas' }}</p></div></div>{% endif %}
{% if canal.tip003 == 'WhatsApp' and canal.pub003 %}<div class="card"><div class="card-header"><strong>Webhooks Z-API</strong></div><div class="card-body"><p class="mb-1">Recebimento:</p><code>/api/zapi/{{ canal.pub003 }}/receber</code><p class="mt-3 mb-1">Entrega:</p><code>/api/zapi/{{ canal.pub003 }}/entrega</code><p class="mt-3 mb-1">Status:</p><code>/api/zapi/{{ canal.pub003 }}/status</code><p class="text-muted small mt-3 mb-0">Configure os três endereços com domínio HTTPS no painel da instância Z-API.</p></div></div>{% endif %}
</div><div class="col-lg-4"><div class="card"><div class="card-header"><strong>Webhook genérico</strong></div><div class="card-body"><p class="mb-2">Endpoint <i class="bi bi-question-circle ms-1 text-muted" tabindex="0" data-bs-toggle="tooltip" title="URL usada por integrações externas para enviar mensagens ao Nexora. A integração deve informar a chave do webhook no cabeçalho X-Nexora-Webhook-Key."></i>:</p><code>/api/webhooks/{{ canal.cod003 }}</code><p class="mt-3 mb-0">Chave: {{ canal.webhook_configured ? 'configurada' : 'não configurada' }}</p></div>{% if can_update %}<div class="card-footer"><form method="post" action="/canais/{{ canal.cod003 }}/nova-chave"><button class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip" title="Invalida a chave atual. Copie e guarde a nova chave, pois ela será mostrada apenas uma vez.">Gerar nova chave</button></form></div>{% endif %}</div></div></div>
{% endblock %}

{% block scripts %}
<script>document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) { new bootstrap.Tooltip(element); });</script>
{% endblock %}
