{% extends 'layouts/adminlte.twig' %}

{% block title %}
    Dashboard | {{ app_name }}
{% endblock %}

{% block page_title %}
    Dashboard
{% endblock %}

{% block content %}

{% if dashboard_enabled %}
<div class="container-fluid">

    <!-- Saudação -->

    <div class="row mb-4">

        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="me-3">

                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 52px; height: 52px;">

                                <i class="bi bi-person text-white fs-4"></i>

                            </div>

                        </div>

                        <div>

                            <h4 class="mb-1">

                                Olá,
                                <strong>
                                    {{ usuario.nome }}
                                </strong>!

                            </h4>

                            <p class="text-muted mb-0">

                                Bem-vindo ao painel administrativo da
                                <strong>{{ app_name }}</strong>.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Informações do usuário -->

    <div class="row">

        <div class="col-lg-4 col-md-6 d-flex">

            <div class="card h-100 w-100">

                <div class="card-header">

                    <h3 class="card-title">

                        <i class="bi bi-person-circle me-2"></i>

                        Usuário

                    </h3>

                </div>

                <div class="card-body">

                    <p class="mb-2">

                        <strong>Nome:</strong>

                        {{ usuario.nome }}

                    </p>

                    <p class="mb-2">

                        <strong>E-mail:</strong>

                        {{ usuario.email }}

                    </p>

                    <p class="mb-0">

                        <strong>Perfil:</strong>

                        <span class="badge text-bg-primary">

                            {{ usuario.perfil_name }}

                        </span>

                    </p>

                </div>

            </div>

        </div>


        <!-- Empresa -->

        <div class="col-lg-4 col-md-6 d-flex">

            <div class="card h-100 w-100">

                <div class="card-header">

                    <h3 class="card-title">

                        <i class="bi bi-building me-2"></i>

                        Empresa

                    </h3>

                </div>

                <div class="card-body">

                    <p class="text-muted mb-0">

                        Empresa vinculada ao usuário:

                    </p>

                    <h5 class="mt-2 mb-0">

                        {{ empresa_atual }}

                    </h5>

                </div>

            </div>

        </div>


        <!-- Sistema -->

        <div class="col-lg-4 col-md-12 d-flex">

            <div class="card h-100 w-100">

                <div class="card-header">

                    <h3 class="card-title">

                        <i class="bi bi-cpu me-2"></i>

                        Sistema

                    </h3>

                </div>

                <div class="card-body">

                    <p class="mb-2">

                        <strong>Plataforma:</strong>

                        {{ app_name }}

                    </p>

                    <p class="mb-2 text-break">

                        <strong>Path:</strong>

                        {{ system_path }}

                    </p>

                    <p class="mb-0">

                        <strong>Status:</strong>

                        <span class="badge text-bg-success">

                            Online

                        </span>

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Resumo -->

    <div class="row mt-2">

        <!-- Empresas -->

        <div class="col-lg-3 col-md-6 col-sm-6">

            <div class="small-box text-bg-primary">

                <div class="inner">

                    <h3>
                        {{ '%04d'|format(resumo.empresas|default(0)) }}
                    </h3>

                    <p>
                        Empresas
                    </p>

                </div>

                <div class="small-box-icon">

                    <i class="bi bi-building"></i>

                </div>

            </div>

        </div>


        <!-- Atendentes -->

        <div class="col-lg-3 col-md-6 col-sm-6">

            <div class="small-box text-bg-success">

                <div class="inner">

                    <h3>
                        {{ '%04d'|format(resumo.atendentes|default(0)) }}
                    </h3>

                    <p>
                        Atendentes
                    </p>

                </div>

                <div class="small-box-icon">

                    <i class="bi bi-people"></i>

                </div>

            </div>

        </div>


        <!-- Clientes -->

        <div class="col-lg-3 col-md-6 col-sm-6">

            <div class="small-box text-bg-warning">

                <div class="inner">

                    <h3>
                        {{ '%04d'|format(resumo.clientes|default(0)) }}
                    </h3>

                    <p>
                        Clientes
                    </p>

                </div>

                <div class="small-box-icon">

                    <i class="bi bi-person-lines-fill"></i>

                </div>

            </div>

        </div>


        <!-- Conversas -->

        <div class="col-lg-3 col-md-6 col-sm-6">

            <div class="small-box text-bg-danger">

                <div class="inner">

                    <h3>
                        {{ '%04d'|format(resumo.conversas|default(0)) }}
                    </h3>

                    <p>
                        Conversas
                    </p>

                </div>

                <div class="small-box-icon">

                    <i class="bi bi-chat-dots"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- Status -->

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <h3 class="card-title">

                        <i class="bi bi-activity me-2"></i>

                        Status da Plataforma

                    </h3>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-4">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-check-circle-fill text-success fs-4 me-2"></i>

                                <div>

                                    <strong>
                                        Aplicação
                                    </strong>

                                    <div class="text-muted">
                                        Funcionando
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-database-check text-success fs-4 me-2"></i>

                                <div>

                                    <strong>
                                        Banco de dados
                                    </strong>

                                    <div class="text-muted">
                                        Conectado
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-shield-check text-success fs-4 me-2"></i>

                                <div>

                                    <strong>
                                        Autenticação
                                    </strong>

                                    <div class="text-muted">
                                        Sessão ativa
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
{% else %}
<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 180px);">
    <img src="/assets/images/logo-wallpaper.png" alt="{{ app_name }}" style="width: 80vw; max-width: 80%; max-height: 80vh; height: auto; object-fit: contain;">
</div>
{% endif %}

{% endblock %}
