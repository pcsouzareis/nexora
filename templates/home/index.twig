<!DOCTYPE html>
<html lang="pt-BR">

	<head>

		<meta charset="UTF-8">

		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>{{ app_name }}</title>
		<link rel="icon" href="/assets/images/favicon-nexora.ico" sizes="any">

		<style>

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				min-height: 100%;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;

				background: #f4f6f8;

				min-height: 100vh;

				display: flex;
				align-items: center;
				justify-content: center;
			}

			.container {
				width: 100%;
				max-width: 500px;
				padding: 20px;
				text-align: center;
			}

			.card {
				background: #ffffff;

				border-radius: 12px;

				padding: 45px 30px;

				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
			}

			.logo {
				margin-bottom: 10px;

				font-size: 32px;
				font-weight: 700;

				color: #222222;
			}

			.description {
				margin: 0 0 30px;

				font-size: 15px;
				line-height: 1.6;

				color: #666666;
			}

			.button {
				display: inline-block;

				padding: 11px 22px;

				border-radius: 7px;

				background: #222222;
				color: #ffffff;

				text-decoration: none;

				font-size: 14px;
				font-weight: 600;
			}

			.button:hover {
				background: #000000;
			}
		</style>

	</head>

	<body>

		<main class="container">

			<section class="card">

				<div class="logo">
					{{ app_name }}
				</div>

				<p class="description">
					Plataforma de comunicação e automação inteligente.
				</p>

				<a href="/login" class="button">
					Acessar
				</a>

			</section>

		</main>

	</body>

</html>
