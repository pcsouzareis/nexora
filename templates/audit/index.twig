{% extends 'layouts/adminlte.twig' %}
{% block title %}Auditoria | {{ app_name }}{% endblock %}
{% block page_title %}Auditoria{% endblock %}
{% block styles %}<link rel="stylesheet" href="https://cdn.datatables.net/3.0.3/css/dataTables.dataTables.css">{% endblock %}
{% block content %}
<div class="card card-outline card-primary"><div class="card-header"><h3 class="card-title"><i class="bi bi-journal-text me-2"></i>Histórico da empresa atual</h3></div><div class="card-body">
<form id="audit-filters" class="row g-3 mb-3"><div class="col-md-3"><label class="form-label" for="audit-from">Data inicial</label><div class="input-group date-picker-group"><input id="audit-from" class="form-control date-br" type="text" placeholder="dd/mm/aaaa" inputmode="numeric" maxlength="10"><input class="date-native" type="date" tabindex="-1" aria-hidden="true"><button class="btn btn-outline-secondary date-picker-button" type="button" aria-label="Selecionar data"><i class="bi bi-calendar3"></i></button></div></div><div class="col-md-3"><label class="form-label" for="audit-until">Data final</label><div class="input-group date-picker-group"><input id="audit-until" class="form-control date-br" type="text" placeholder="dd/mm/aaaa" inputmode="numeric" maxlength="10"><input class="date-native" type="date" tabindex="-1" aria-hidden="true"><button class="btn btn-outline-secondary date-picker-button" type="button" aria-label="Selecionar data"><i class="bi bi-calendar3"></i></button></div></div><div class="col-md-2"><label class="form-label" for="audit-action">Ação</label><select id="audit-action" class="form-select"><option value="">Todas</option>{% for item in filtros.actions %}<option value="{{ item }}">{{ item }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label" for="audit-entity">Entidade</label><select id="audit-entity" class="form-select"><option value="">Todas</option>{% for item in filtros.entities %}<option value="{{ item }}">{{ item }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label" for="audit-user">Usuário</label><select id="audit-user" class="form-select"><option value="">Todos</option>{% for item in filtros.users %}<option value="{{ item.cod002 }}">{{ item.des002 }}</option>{% endfor %}</select></div><div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Aplicar filtros</button><button id="audit-clear" class="btn btn-outline-secondary ms-1" type="button">Limpar</button></div></form>
<div class="table-responsive"><table id="audit-table" class="table table-hover align-middle w-100"><thead><tr><th>Data</th><th>Usuário</th><th>Ação</th><th>Entidade</th><th>Descrição</th><th>IP</th></tr></thead></table></div></div></div>
{% endblock %}
{% block scripts %}<script src="https://cdn.datatables.net/3.0.3/js/dataTables.js"></script><script>document.addEventListener('DOMContentLoaded',function(){const field=function(id){return document.getElementById(id).value},iso=function(value){const match=/^(\d{2})\/(\d{2})\/(\d{4})$/.exec(value);return match?match[3]+'-'+match[2]+'-'+match[1]:''};document.querySelectorAll('.date-picker-group').forEach(function(group){const input=group.querySelector('.date-br'),native=group.querySelector('.date-native');native.style.cssText='position:absolute;opacity:0;width:1px;height:1px;pointer-events:none;';input.addEventListener('input',function(){const digits=input.value.replace(/\D/g,'').slice(0,8);input.value=digits.replace(/^(\d{2})(\d)/,'$1/$2').replace(/^(\d{2}\/\d{2})(\d)/,'$1/$2')});group.querySelector('.date-picker-button').addEventListener('click',function(){if(typeof native.showPicker==='function')native.showPicker();else native.focus()});native.addEventListener('change',function(){if(native.value){const parts=native.value.split('-');input.value=parts[2]+'/'+parts[1]+'/'+parts[0]}})});const table=new DataTable('#audit-table',{serverSide:true,processing:true,pageLength:25,lengthMenu:[25,50,100],searchDelay:350,ajax:{url:'/auditoria/dados',data:function(data){data.from=iso(field('audit-from'));data.until=iso(field('audit-until'));data.action=field('audit-action');data.entity=field('audit-entity');data.user=field('audit-user')}},columns:[{data:'data'},{data:'usuario'},{data:'aca017'},{data:null,render:function(value,type,row){return row.ent017+(row.ref017?' #'+row.ref017:'')}},{data:'des017'},{data:'ip017',defaultContent:'—'}],language:{url:'https://cdn.datatables.net/plug-ins/2.3.0/i18n/pt-BR.json'}});document.getElementById('audit-filters').addEventListener('submit',function(event){event.preventDefault();table.ajax.reload()});document.getElementById('audit-clear').addEventListener('click',function(){document.getElementById('audit-filters').reset();table.ajax.reload()})});</script>{% endblock %}
