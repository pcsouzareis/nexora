{% extends 'layouts/adminlte.twig' %}

{% block title %}
    Empresas | {{ app_name }}
{% endblock %}

{% block page_title %}
    Empresas
{% endblock %}

{% block content %}

<div class="container-fluid">

    {# =========================================================
       Cabeçalho
       ========================================================= #}

    <div class="row mb-3">

        <div class="col-12">

            <div class="d-flex justify-content-between align-items-center">

                {% if can_create %}
                <div>

                    <h4 class="mb-1">

                        <i class="bi bi-building me-2"></i>

                        Empresas

                    </h4>

                    <p class="text-muted mb-0">

                        Organizações cadastradas na plataforma.

                    </p>

                </div>
                {% endif %}

                <div>

                    <a
                        href="/empresas/criar"
                        class="btn btn-primary"
                    >

                        <i class="bi bi-plus-lg me-1"></i>

                        Nova Empresa

                    </a>

                </div>

            </div>

        </div>

    </div>


    {# =========================================================
       Lista de Empresas
       ========================================================= #}

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <h3 class="card-title">

                        <i class="bi bi-list-ul me-2"></i>

                        Lista de Empresas

                    </h3>

                    <div class="card-tools">

                        <span class="badge text-bg-secondary">

                            {{ empresas|length }}

                            empresa{% if empresas|length != 1 %}s{% endif %}

                        </span>

                    </div>

                </div>


                <div class="card-body p-0">

                    {% if empresas is empty %}

                        {# =================================================
                           Nenhuma empresa
                           ================================================= #}

                        <div class="text-center py-5">

                            <i class="bi bi-building display-4 text-muted"></i>

                            <h5 class="mt-3">

                                Nenhuma empresa encontrada

                            </h5>

                            <p class="text-muted mb-3">

                                Ainda não existem empresas cadastradas.

                            </p>

                            {% if can_create %}
                            <a
                                href="/empresas/criar"
                                class="btn btn-primary"
                            >

                                <i class="bi bi-plus-lg me-1"></i>

                                Cadastrar Empresa

                            </a>
                            {% endif %}

                        </div>

                    {% else %}

                        {# =================================================
                           Tabela
                           ================================================= #}

                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead>

                                    <tr>

                                        <th style="width: 80px;">
                                            Código
                                        </th>

                                        <th>
                                            Empresa
                                        </th>

                                        <th>
                                            Documento
                                        </th>

                                        <th>
                                            E-mail
                                        </th>

                                        <th>
                                            Telefone
                                        </th>

                                        <th style="width: 100px;">
                                            Status
                                        </th>

                                        <th style="width: 120px;">
                                            Ações
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    {% for empresa in empresas %}

                                        <tr>

                                            {# Código #}

                                            <td>

                                                <strong>

                                                    #{{ empresa.cod001 }}

                                                </strong>

                                            </td>


                                            {# Empresa #}

                                            <td>

                                                <div class="d-flex align-items-center">

                                                    <div
                                                        class="bg-primary-subtle rounded-circle d-flex align-items-center justify-content-center me-2"
                                                        style="width: 38px; height: 38px;"
                                                    >

                                                        <i class="bi bi-building text-primary"></i>

                                                    </div>

                                                    <div>

                                                        <strong>

                                                            {{ empresa.des001 }}

                                                        </strong>

                                                    </div>

                                                </div>

                                            </td>


                                            {# Documento #}

                                            <td>

                                                {{ empresa.doc001|default('—') }}

                                            </td>


                                            {# E-mail #}

                                            <td>

                                                {{ empresa.ema001 }}

                                            </td>


                                            {# Telefone #}

                                            <td>

                                                {{ empresa.tel001|default('—') }}

                                            </td>


                                            {# Status #}

                                            <td>

                                                {% if empresa.sts001 %}

                                                    <span class="badge text-bg-success">

                                                        Ativa

                                                    </span>

                                                {% else %}

                                                    <span class="badge text-bg-secondary">

                                                        Inativa

                                                    </span>

                                                {% endif %}

                                            </td>


                                            {# Ações #}

                                            <td>

                                                <div class="btn-group">

                                                    {# Visualizar #}

                                                    {% if can_view %}
                                                    <a
                                                        href="/empresas/{{ empresa.cod001 }}"
                                                        class="btn btn-sm btn-outline-primary"
                                                        title="Visualizar"
                                                    >

                                                        <i class="bi bi-eye"></i>

                                                    </a>
                                                    {% endif %}


                                                    {# Editar #}

                                                    {% if can_update %}
                                                    <a
                                                        href="/empresas/{{ empresa.cod001 }}/editar"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Editar"
                                                    >

                                                        <i class="bi bi-pencil"></i>

                                                    </a>
                                                    {% endif %}

                                                </div>

                                            </td>

                                        </tr>

                                    {% endfor %}

                                </tbody>

                            </table>

                        </div>

                    {% endif %}

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}
