{
    "name": "nexora/base-chatbots",
    "description": "Sistema de Chatbots para Atendimento ao Cliente",
    "type": "project",
    "require": {
        "php": "^8.4",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "twig/twig": "^3.21",
        "doctrine/dbal": "^4.3",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.9",
        "symfony/validator": "^7.3",
        "symfony/cache": "^7.3",
        "vlucas/phpdotenv": "^5.6",
        "slim/twig-view": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "phpstan/phpstan": "^2.1",            
        "symfony/var-dumper": "^7.2"
    
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
